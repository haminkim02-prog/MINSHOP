---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지가 없습니다." noindex>
  <div class="wrap">
    <article class="prose-wrap" style="text-align:center;padding-block:3rem">
      <p style="font-family:var(--font-serif);font-size:4rem;margin:0;color:var(--text-faint)">
        404
      </p>
      <h1 style="font-family:var(--font-serif);font-size:1.75rem;margin:.5rem 0 1rem">
        페이지를 찾을 수 없습니다
      </h1>
      <p style="color:var(--text-soft);margin-bottom:2rem">
        주소가 바뀌었거나 삭제된 글일 수 있습니다.
      </p>
      <p>
        <a class="chip" href="/">홈으로</a>
        <a class="chip" href="/blog/">전체 글 보기</a>
      </p>
    </article>
  </div>
</BaseLayout>
