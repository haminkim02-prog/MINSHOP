---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES } from '../../consts.js';
import { getPosts } from '../../lib/posts.js';

const posts = await getPosts();
---

<BaseLayout title="전체 글" description="지금까지 쓴 모든 글을 최신순으로 모았습니다.">
  <div class="wrap">
    <section class="hero">
      <h1>전체 글</h1>
      <p>총 {posts.length}편. 최신순입니다.</p>
    </section>

    <ul class="chips">
      {
        CATEGORIES.map((c) => (
          <li>
            <a class="chip" href={`/category/${c.slug}/`}>
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>

    {
      posts.length === 0 ? (
        <p class="empty">아직 글이 없습니다.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
